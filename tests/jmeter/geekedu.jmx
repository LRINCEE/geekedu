        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Order Flow - Init Vars">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def suffix = java.util.UUID.randomUUID().toString().replace('-', '')&#10;vars.put('student_username', 'jm_order_' + suffix)&#10;vars.put('student_password', vars.get('studentPassword'))</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Order Flow - Register Student">
